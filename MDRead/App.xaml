<Application x:Class="MDRead.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="clr-namespace:MDRead.Constants"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="Menu">
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBackground}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuForeground}}" />
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBackground}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuForeground}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding"
                        Value="{x:Static constants:UiStyleConstants.MenuItemPadding}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid x:Name="ItemGrid"
                                          MinWidth="{x:Static constants:UiStyleConstants.SubmenuMinimumWidth}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Static constants:UiStyleConstants.CheckmarkColumnWidth}" />
                                            <ColumnDefinition Width="{x:Static constants:UiStyleConstants.HeaderColumnWidth}" />
                                            <ColumnDefinition Width="{x:Static constants:UiStyleConstants.GestureColumnWidth}" />
                                            <ColumnDefinition Width="{x:Static constants:UiStyleConstants.ArrowColumnWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckMark"
                                                   Text="{x:Static constants:UiStyleConstants.Checkmark}"
                                                   Visibility="Collapsed"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   FontWeight="SemiBold" />
                                        <ContentPresenter x:Name="HeaderPresenter"
                                                          Grid.Column="1"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="True"
                                                          VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{TemplateBinding InputGestureText}"
                                                   Opacity="{x:Static constants:UiStyleConstants.InputGestureOpacity}"
                                                   Margin="{x:Static constants:UiStyleConstants.InputGestureMargin}"
                                                   VerticalAlignment="Center" />
                                        <Path x:Name="Arrow"
                                              Grid.Column="3"
                                              Data="{x:Static constants:UiStyleConstants.SubmenuArrowGeometry}"
                                              Fill="{TemplateBinding Foreground}"
                                              Width="{x:Static constants:UiStyleConstants.SubmenuArrowWidth}"
                                              Height="{x:Static constants:UiStyleConstants.SubmenuArrowHeight}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       Placement="Right">
                                    <Border Background="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBackground}}"
                                            BorderBrush="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBorder}}"
                                            BorderThickness="{x:Static constants:UiStyleConstants.PopupBorderThickness}"
                                            Padding="{x:Static constants:UiStyleConstants.PopupPadding}">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ItemGrid"
                                            Property="MinWidth"
                                            Value="{x:Static constants:UiStyleConstants.TopLevelMenuMinimumWidth}" />
                                    <Setter TargetName="HeaderPresenter" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="HeaderPresenter"
                                            Property="Grid.ColumnSpan"
                                            Value="{x:Static constants:UiStyleConstants.TopLevelHeaderColumnSpan}" />
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelItem">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuHover}}" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuHover}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuHover}}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static constants:ThemeResourceKeys.DisabledForeground}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="{x:Static constants:UiStyleConstants.SeparatorThickness}"
                                    Margin="{x:Static constants:UiStyleConstants.MenuSeparatorMargin}"
                                    Background="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBorder}}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="{x:Static constants:UiResourceKeys.EditorScrollBarStyle}"
                   TargetType="ScrollBar">
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.ScrollTrack}}" />
                <Setter Property="Width"
                        Value="{x:Static constants:UiStyleConstants.ScrollBarSize}" />
                <Setter Property="Height"
                        Value="{x:Static constants:UiStyleConstants.ScrollBarSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Background="{DynamicResource {x:Static constants:ThemeResourceKeys.ScrollThumb}}">
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="{x:Static constants:UiStyleConstants.ScrollThumbCornerRadius}"
                                                                        Margin="{x:Static constants:UiStyleConstants.ScrollThumbMargin}" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource {x:Static constants:ThemeResourceKeys.ScrollThumbHover}}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolBarTray">
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBackground}}" />
            </Style>

            <Style TargetType="ToolBar">
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBackground}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuForeground}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolBar">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBorder}}"
                                    BorderThickness="{x:Static constants:UiStyleConstants.ToolBarBorderThickness}">
                                <ToolBarPanel IsItemsHost="True"
                                              Margin="{x:Static constants:UiStyleConstants.ToolBarMargin}"
                                              Orientation="Horizontal" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button">
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuForeground}}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding"
                        Value="{x:Static constants:UiStyleConstants.ToolBarButtonPadding}" />
                <Setter Property="Margin"
                        Value="{x:Static constants:UiStyleConstants.ToolBarButtonMargin}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="{x:Static constants:UiStyleConstants.ToolBarButtonCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuHover}}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBorder}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Width="{x:Static constants:UiStyleConstants.SeparatorThickness}"
                                    Margin="{x:Static constants:UiStyleConstants.ToolBarSeparatorMargin}"
                                    Background="{DynamicResource {x:Static constants:ThemeResourceKeys.MenuBorder}}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
